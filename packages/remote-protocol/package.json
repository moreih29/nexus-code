{
  "name": "@nexus-code/remote-protocol",
  "version": "0.6.0",
  "description": "NexusCode's remote protocol: the relay's frames and the end-to-end RPC between a user's devices",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreih29/nexus-code.git",
    "directory": "packages/remote-protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
