<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 JIT in Electron's main process, including ELECTRON_RUN_AS_NODE. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Voice input and note recording use the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Terminal and agent child processes may capture video from a camera. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Terminal and agent child processes may automate apps using Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Terminal and agent child processes may request access to Location Services. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- Terminal and agent child processes may access Contacts. -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <!-- Terminal and agent child processes may access calendars through EventKit. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Terminal and agent child processes may access the Photos library. -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
  </dict>
</plist>
